 "parts": {
  "rpi4b-2gb": {"id":"rpi4b-2gb","slot":"brain","name":"Raspberry Pi 4 Model B, 2 GB","maker":"Raspberry Pi","model":"Pi 4 Model B 2 GB","status":"installed","does":"The main computer: runs the camera, speech, hearing, scene memory and the hand-drive page.","dims":[85,56,17],"mass":46,"est":["mass","price"],"price":67.5,"priceEst":true,"note":"Its USB ports share 1.2 A in total. The 6.4 W peak is a third-party test with all four cores busy; Raspberry Pi's own worst-case figure for the Pi 4 is about 8 W. Price is one shop's on the check date; the build note guessed about $45."},
  "emeet-c980-pro": {"id":"emeet-c980-pro","slot":"camera","name":"eMeet C980 Pro webcam","maker":"eMeet","model":"C980 Pro","status":"installed","does":"Asher's only eye: a wide USB webcam, read at 640 by 480 about 20 times a second.","dims":[32,159,40],"mass":235,"est":["dims"],"price":89.99,"priceEst":true,"note":"Lies crosswise at the very front on its own clip, which hooks over the upper deck's front edge. The lens is about 95 mm off the floor. It is wider than the decks. Its microphones and speakers are Asher's ears and voice, and the distance sensor rides on its top."},
  "hc-sr04": {"id":"hc-sr04","slot":"range","name":"HC-SR04 ultrasonic distance sensor","maker":"generic (in the kit)","model":"HC-SR04","status":"installed","does":"Measures how far the nearest thing ahead is, by timing an echo.","dims":[15,45,20],"mass":8.5,"est":[],"price":0,"priceEst":false,"note":"Came in the kit. Sits on top of the webcam in the kit's cat-face bracket, tipped back 12 degrees, its two transducers about 136 mm off the floor. On Asher it hears no echo about half the time."},
  "acebott-esp32-max": {"id":"acebott-esp32-max","slot":"controller","name":"ACEBOTT ESP32 Max controller board","maker":"ACEBOTT","model":"ESP32 Max V1.0 (QA007)","status":"installed","does":"The small board that runs the reflexes and tells the motor shield what to do, over WiFi from the main computer.","dims":[68.1,52.1,15],"mass":25,"est":["dims","mass"],"price":0,"priceEst":false,"note":"Came in the kit. Makes its own 5 V and 3.3 V from the motor battery."},
  "acebott-qa052-shield": {"id":"acebott-qa052-shield","slot":"driver","name":"ACEBOTT car shield","maker":"ACEBOTT","model":"QA052 ESP32 Car Shield V1.0","status":"installed","does":"Sits on the controller board and switches battery power to the four motors.","dims":[68.1,52.1,12],"mass":22,"est":["dims"],"price":0,"priceEst":false,"note":"Came in the kit. 3 A in total; one speed line is shared by all four motors, so they cannot run at different speeds."},
  "drive-tt-mecanum": {"id":"drive-tt-mecanum","slot":"drive","name":"Four TT motors with 60 mm mecanum wheels","maker":"ACEBOTT (kit)","model":"TT geared motor 1:48, 60 mm mecanum wheel","status":"installed","does":"Four small geared motors and four wheels with angled rollers, so the car can also slide sideways.","dims":[30,60,60],"mass":292,"est":["dims","mass"],"price":0,"priceEst":false,"note":"Came in the kit. Watts are the kit's whole-car figures less the boards. Size is one wheel. All four stalled would ask about 6 A."},
  "nuon-18650-x2": {"id":"nuon-18650-x2","slot":"battery","name":"Two 18650 lithium-ion cells","maker":"Nuon","model":"18650, button top, protected, in the kit's two-cell holder","status":"installed","does":"The motor battery: runs the motors, the shield, the controller board and the distance sensor.","dims":[69,18.5,18.5],"mass":96,"est":["dims","mass","price"],"price":null,"priceEst":true,"note":"Capacity is not in Ben's files. 8 Wh is worked back from the measured 1.5 to 2 hours of mixed driving, so it may be low."},
  "anker-powercore-slim-10000": {"id":"anker-powercore-slim-10000","slot":"computer-battery","name":"Anker PowerCore Slim 10000 PD power bank","maker":"Anker","model":"A1231","status":"installed","does":"The computer battery: runs the main computer, the fan and the webcam.","dims":[149.6,68.6,14.5],"mass":213,"est":["price"],"price":40,"priceEst":true,"note":"The volts here are the cell inside. What the robot sees is its USB-C socket: 5 V at up to 3 A, listed as its own part."},
  "anker-usb-c-out": {"id":"anker-usb-c-out","slot":"regulator","name":"The power bank's own 5 V socket","maker":"Anker","model":"USB-C output of the A1231","status":"installed","does":"Turns the power bank's cell voltage into the 5 V the computer runs on.","dims":[0,0,0],"mass":0,"est":[],"price":0,"priceEst":false,"note":"Part of the power bank: it only works with that battery.","builtInto":"anker-powercore-slim-10000"},
  "emeet-c980-audio": {"id":"emeet-c980-audio","slot":"audio","name":"Microphones and speakers in the webcam","maker":"eMeet","model":"C980 Pro","status":"installed","does":"Asher's ears and voice. They are inside the webcam.","dims":[0,0,0],"mass":0,"est":[],"price":0,"priceEst":false,"note":"Part of the webcam, no separate price or power. Ben's files say two microphones, the maker says four. Two 1 W speakers.","builtInto":"emeet-c980-pro"},
  "acebott-kit-plates": {"id":"acebott-kit-plates","slot":"fixed","name":"Two black acrylic kit decks","maker":"ACEBOTT","model":"QD001 kit, bottom and top plate","status":"installed","does":"The lower deck carries the motors; the upper deck carries the controller, shield and motor battery.","dims":[220,98,3],"mass":160,"est":["dims","mass"],"price":60,"priceEst":false,"note":"The price is what Ben paid for the whole kit: plates, motors, wheels, controller, shield, distance sensor and battery holder."},
  "homemade-plates": {"id":"homemade-plates","slot":"fixed","name":"Two plates cut from a plastic litter box","maker":"home-made","model":"about 3 mm HDPE, two","status":"installed","does":"Ben's two extra plates: one on short standoffs over the front carries the main computer; one on tall standoffs over the rear carries the power bank.","dims":[92,94,3],"mass":130,"est":["dims","mass"],"price":0,"priceEst":false,"note":"Two sizes: 92 x 94 mm under the computer and 84 x 102 mm under the power bank, both about 3 mm thick."},
  "standoffs": {"id":"standoffs","slot":"fixed","name":"Pillars, standoffs and screws","maker":"ACEBOTT kit and loose parts","model":"eight 40 mm and five 14 mm M3 brass pillars, M2.5 standoffs","status":"installed","does":"Hold the decks apart.","dims":[0,0,0],"mass":60,"est":["mass"],"price":0,"priceEst":false},
  "sensor-bracket": {"id":"sensor-bracket","slot":"fixed","name":"Cat-face bracket on a 3D-printed angle","maker":"home-made","model":"3D print","status":"installed","does":"Holds the distance sensor on top of the webcam, tipped back 12 degrees: the kit's acrylic cat-face bracket on a white printed angle that is foam-taped to the webcam's top.","dims":[0,0,0],"mass":5,"est":["mass"],"price":0,"priceEst":false},
  "case-fan": {"id":"case-fan","slot":"fixed","name":"Computer case with fan","maker":"not named in Ben's files","model":"Pi 4 case with fan","status":"installed","does":"Protects and cools the main computer.","dims":[72,85,33],"mass":60,"est":["dims","mass","price"],"price":10,"priceEst":true,"note":"A Miuzei fan case, about 72 x 85 x 33 mm. Weight and fan draw are not in Ben's files. It is a Pi 4 case, so it leaves the build when the main computer is swapped; the Pi 5 options come with their own fan cooler and the Jetson kit has a fan.","builtInto":"rpi4b-2gb"},
  "microsd-32": {"id":"microsd-32","slot":"fixed","name":"32 GB memory card","maker":"generic","model":"microSD 32 GB","status":"installed","does":"Holds the main computer's software.","dims":[15,11,1],"mass":0.5,"est":["mass","price"],"price":8,"priceEst":true,"note":"Its draw is inside the main computer's figure."},
  "battery-holder-switch": {"id":"battery-holder-switch","slot":"fixed","name":"Two-cell battery holder and power switch","maker":"ACEBOTT (kit)","model":"kit holder with in-line switch","status":"installed","does":"Holds the two motor cells crosswise on the upper deck, under the power bank plate, and switches the motor side on and off.","dims":[41,77,16],"mass":20,"est":["dims","mass"],"price":0,"priceEst":false},
  "controller-regulators": {"id":"controller-regulators","slot":"fixed","name":"Regulators on the controller board","maker":"ACEBOTT","model":"chips not named in the files","status":"installed","does":"Make the 5 V and 3.3 V that the controller and the distance sensor use.","dims":[0,0,0],"mass":0,"est":[],"price":0,"priceEst":false,"note":"Part of the controller board. The two Arduino boards that can run from the motor battery and make 5 V have their own entry; the other controllers give the distance sensor no 5 V.","builtInto":"acebott-esp32-max"}
